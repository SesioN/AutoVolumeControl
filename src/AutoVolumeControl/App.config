<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      CSCore registers COM callbacks in constructors and unregisters them in finalizers. If the audio service
      stopped, such an unregister throws on the finalizer thread, which would otherwise end the process. The
      exception is still logged by the AppDomain.UnhandledException handler.
    -->
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
